# Transport-independent RPC, for support/asyn and support/StreamDevice
TIRPC=YES

# Disable PCRE for support/StreamDevice until it is updated for libpcre2
undefine PCRE
#PCRE_LIB=/usr/lib/x86_64-linux-gnu
#PCRE_INCLUDE=/usr/include/
#PCRE=$(SUPPORT)/pcre

# Enable PCRE for extensions/ca-gateway
USE_PCRE2=YES

# Path to the Open62541 C++ installation, for support/opcua
OPEN62541=/opt/open62541
OPEN62541_DEPLOY_MODE = PROVIDED
OPEN62541_LIB_DIR = $(OPEN62541)/lib
OPEN62541_SHRLIB_DIR = $(OPEN62541_LIB_DIR)
OPEN62541_USE_CRYPTO = YES

# Build static libraries, but not static binaries
SHARED_LIBRARIES=NO
ENABLE_STATIC=YES
STATIC_BUILD=YES
